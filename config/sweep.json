{
  "seed": "random",
  "max_env_steps": 512,
  "updates_per_jit": 1,
  "update_steps": 5000,
  "learner": {
    "optimizer": {
      "type": "muon",
      "learning_rate": 0.00108986115210741,
      "weight_decay": 6.44516289841076e-06,
      "eps": 1e-8,
      "beta1": 0.9,
      "beta2": 0.98,
      "max_norm": 0.39644292421090327
    },
    "model": {
      "obs_encoder": {
        "obs_type": "grid_cnn",
        "kernels": [
          [3, 3],
          [3, 3],
          [3, 3]
        ],
        "strides": [
          [2, 2],
          [1, 1],
          [1, 1]
        ],
        "channels": [16, 32]
      },
      "hidden_features": 256,
      "layer": {
        "feed_forward": {
          "glu": true,
          "size": 768
        },
        "history": {
          "type": "attention",
          "num_heads": 4,
          "num_kv_heads": 1,
          "head_dim": 32,
          "sliding_window": null,
          "rope_max_wavelength": 10000.0,
          "use_qk_norm": false
        },
        "use_post_attn_norm": false,
        "use_post_ffw_norm": false
      },
      "num_layers": 16,
      "value_hidden_dim": 768,
      "value": {
        "type": "hl_gauss",
        "min": -10.0,
        "max": 10.0,
        "n_logits": 51,
        "sigma": 0.3
      },
      "activation": "gelu",
      "norm": "rms_norm",
      "kernel_init": "glorot_uniform",
      "dtype": "bfloat16",
      "param_dtype": "float32"
    },
    "trainer": {
      "trainer_type": "ppo",
      "epoch_count": 1,
      "minibatch_count": 32,
      "vf_coef": 3.961649728218663,
      "entropy_coef": 0.002901889285198761,
      "pg_clip": 0.1,
      "discount": 0.995,
      "gae_lambda": 0.8041539043144189,
      "normalize_advantage": true
    }
  },
  "environment": {
    "env_type": "find_return",
    "num_agents": 8,
    "width": 40,
    "height": 40,
    "view_width": 11,
    "view_height": 11
  },
  "num_envs": 512,
  "logger": {
    "use_console": true,
    "use_wandb": true,
    "use_jsonl": true
  }
}
