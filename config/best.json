{
  "seed": "random",
  "max_env_steps": 512,
  "updates_per_jit": 1,
  "update_steps": 500,
  "num_envs": 512,
  "learner": {
    "optimizer": {
      "type": "muon",
      "learning_rate": 0.0010822848551700177,
      "weight_decay": 0.01,
      "eps": 1e-8,
      "beta1": 0.9353521064414686,
      "beta2": 0.9040155258546868,
      "max_norm": 0.39644292421090327
    },
    "model": {
      "obs_encoder": {
        "obs_type": "grid_cnn",
        "kernels": [[3, 5], [3, 3], [3, 3]],
        "strides": [[2, 2], [2, 2], [1, 1]],
        "channels": [16, 32]
      },
      "hidden_features": 256,
      "layer": {
        "feed_forward": {
          "size": 512,
          "glu": true
        },
        "history": {
          "type": "attention",
          "num_heads": 8,
          "num_kv_heads": 1,
          "head_dim": 32,
          "sliding_window": null,
          "rope_max_wavelength": 10000.0,
          "use_qk_norm": false
        },
        "use_post_attn_norm": false,
        "use_post_ffw_norm": false
      },
      "num_layers": 12,
      "value_hidden_dim": 256,
      "value": {
        "type": "hl_gauss",
        "min": -1.0,
        "max": 19.0,
        "n_logits": 51,
        "sigma": 0.3
      },
      "activation": "gelu",
      "norm": "rms_norm",
      "kernel_init": "glorot_uniform",
      "dtype": "bfloat16",
      "param_dtype": "float32"
    },
    "trainer": {
      "trainer_type": "ppo",
      "epoch_count": 1,
      "minibatch_count": 32,
      "vf_coef": 3.01,
      "entropy_coef": 0.01,
      "pg_clip": 0.207,
      "discount": 0.996,
      "gae_lambda": 0.84,
      "normalize_advantage": true
    }
  },
  "environment": {
    "env_type": "rust_find_return",
    "num_agents": 8,
    "num_flags": 1,
    "width": 40,
    "height": 40,
    "view_width": 15,
    "view_height": 15,
    "mapgen_threshold": 0.07,
    "digging_timeout": 5,
    "treasure_reward": 1.0
  },
  "logger": {
    "use_console": true,
    "use_tb": true
  }
}
