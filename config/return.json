{
  "learner": {
  "model": {
    "norm": "rms_norm",
    "dtype": "bfloat16",
    "layer": {
      "history": {
        "type": "attention",
        "head_dim": 32,
        "num_heads": 4,
        "use_qk_norm": false,
        "num_kv_heads": 1,
        "sliding_window": null,
        "rope_max_wavelength": 10000
      },
      "feed_forward": {
        "glu": true,
        "size": 768
      },
      "use_post_ffw_norm": false,
      "use_post_attn_norm": false
    },
    "value": {
      "max": 10,
      "min": -10,
      "type": "hl_gauss",
      "sigma": 0.3,
      "n_logits": 51
    },
    "activation": "gelu",
    "num_layers": 8,
    "kernel_init": "glorot_uniform",
    "obs_encoder": {
      "kernels": [[3, 3], [3, 3], [3, 3]],
      "strides": [[2, 2], [1, 1], [1, 1]],
      "channels": [16, 32],
      "obs_type": "grid_cnn"
    },
    "param_dtype": "float32",
    "hidden_features": 256,
    "value_hidden_dim": 768
  },
  "trainer": {
    "vf_clip": 0.1,
    "vf_coef": 3.961649728218663,
    "discount": 0.995,
    "gae_lambda": 0.8041539043144189,
    "epoch_count": 1,
    "entropy_coef": 0.002901889285198761,
    "trainer_type": "ppo",
    "minibatch_count": 32,
    "entropy_coef_end": 0,
    "normalize_advantage": true
  },
  "optimizer": {
    "eps": 1e-8,
    "type": "muon",
    "beta1": 0.9,
    "beta2": 0.98,
    "max_norm": 0.39644292421090327,
    "weight_decay": 0.00000644516289841076,
    "learning_rate": 0.00108986115210741
  }
  },
  "num_envs": 512,
  "environment": {
    "width": 40,
    "height": 40,
    "env_type": "find_return",
    "map_path": null,
    "num_flags": 1,
    "num_agents": 8,
    "view_width": 11,
    "view_height": 11,
    "digging_timeout": 5,
    "treasure_reward": 1,
    "mapgen_threshold": 0.3
  },
  "update_steps": 500,
  "max_env_steps": 512,
  "num_checkpoints": 50,
  "snapshot_league": false,
  "updates_per_jit": 1
}
