{
  "seed": "random",
  "max_env_steps": 32,
  "updates_per_jit": 1,
  "update_steps": 5000,
  "num_checkpoints": 50,
  "learner": {
    "optimizer": {
      "type": "muon",
      "learning_rate": 0.01,
      "weight_decay": 0.00010718901435954378,
      "eps": 1e-8,
      "beta1": 0.9353521064414686,
      "beta2": 0.9040155258546868,
      "max_norm": 0.39644292421090327
    },
    "model": {
      "obs_encoder": {
        "obs_type": "grid_cnn",
        "kernels": [
          [3, 3],
          [3, 3],
          [3, 3]
        ],
        "strides": [
          [2, 2],
          [1, 1],
          [1, 1]
        ],
        "channels": [16, 32]
      },
      "hidden_features": 128,
      "layer": {
        "feed_forward": {
          "size": 256,
          "glu": true
        },
        "history": {
          "type": "attention",
          "num_heads": 4,
          "num_kv_heads": 1,
          "head_dim": 32,
          "sliding_window": null,
          "rope_max_wavelength": 10000.0,
          "use_qk_norm": false
        },
        "use_post_attn_norm": false,
        "use_post_ffw_norm": false
      },
      "num_layers": 4,
      "value_hidden_dim": 256,
      "value": {
        "type": "hl_gauss",
        "min": -10.0,
        "max": 10.0,
        "n_logits": 51,
        "sigma": 0.10381270166884848
      },
      "activation": "gelu",
      "norm": "rms_norm",
      "kernel_init": "glorot_uniform",
      "dtype": "bfloat16",
      "param_dtype": "float32"
    },
    "trainer": {
      "trainer_type": "ppo",
      "epoch_count": 1,
      "minibatch_count": 32,
      "vf_coef": 0.5392535826611433,
      "entropy_coef": 0.1,
      "entropy_coef_end": 0.0,
      "pg_clip": 0.2827893540340816,
      "discount": 1.0,
      "gae_lambda": 0.91,
      "normalize_advantage": true
    }
  },
  "num_envs": 2048,
  "environment": {
    "env_type": "embodied_comm",
    "view_width": 11,
    "view_height": 11,
    "full_info": true,
    "color_probs": [
      0.08581592, 0.09484126, 0.1048158, 0.11583937, 0.1280223, 0.14148653,
      0.15636679, 0.17281203
    ]
  },
  "logger": {
    "use_console": true,
    "use_wandb": true,
    "use_jsonl": true
  },
  "snapshot_league": false
}

